# Python
# (dockerignore patterns are root-relative; **/ prefixes make them match nested
# copies too — apps/quiz-pack-api/.venv alone added ~800 MB to the build context)
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
**/.venv/
venv/
**/venv/
ENV/
env/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Development
.env
.env.local
*.log
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Data directories (will be mounted as volumes)
data/
**/data/
# ...except the prompt example corpus, which is code-like input the
# quiz-pack-api image must carry (apps/quiz-pack-api/Dockerfile COPYs it).
!data/examples/
chroma_data/
*.db
*.sqlite

# Git
.git/
.gitignore
.gitattributes

# Documentation
README.md
*.md
docs/

# Tests
test*/
*_test.py
tests/

# CI/CD
.github/
.gitlab-ci.yml

# Temporary files
tmp/
temp/
*.tmp
