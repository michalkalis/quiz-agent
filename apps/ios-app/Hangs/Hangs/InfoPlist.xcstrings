      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon potřebujeme, abychom mohli nahrávat tvoje odpovědi v kvízu. Hraješ tak bez rukou, i během jízdy."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We need microphone access to record your quiz answers hands-free while driving."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofón potrebujeme, aby sme mohli nahrávať tvoje odpovede v kvíze. Hráš tak bez rúk, aj počas jazdy."
          }
        }
