default_platform(:ios)

# -----------------------------------------------------------------------------
# Hangs — fastlane
#
# Auth model:
#   All Apple interactions go through the App Store Connect API key (JWT).
#   Required env vars:
#     ASC_API_KEY_ID       — 10-char key identifier
#     ASC_API_ISSUER_ID    — UUID of the issuer (team-wide)
#     ASC_API_KEY_CONTENT  — contents of the .p8 file (entire text incl. BEGIN/END)
#
#   On CI these come from GitHub Actions Secrets. Locally, create `.env.secret`
#   in this directory (gitignored) or export them in your shell.
#
# Cert storage:
#   `match` pulls encrypted certs + profiles from the MATCH_GIT_URL repo, decrypts
#   with MATCH_PASSWORD, installs into a temporary keychain named by
#   MATCH_KEYCHAIN_NAME. On CI the keychain is created + destroyed inside the
#   workflow — nothing persists between runs.
# -----------------------------------------------------------------------------

# #234 — Trubbo Beta: the TestFlight build of Release-Prod (APP_STORE_VARIANT=NO)
# is its own app, `com.missinghue.hangs.beta`; the App Store variant stays the
# live app. Prod.xcconfig picks the same id at compile time; Staging (deprecated)
# keeps the live id.
LIVE_BUNDLE_ID = "com.missinghue.hangs"
BETA_BUNDLE_ID = "com.missinghue.hangs.beta"
ALL_BUNDLE_IDS = [LIVE_BUNDLE_ID, BETA_BUNDLE_ID].freeze

def bundle_id_for(configuration:, store_variant:)
  configuration == "Release-Prod" && !store_variant ? BETA_BUNDLE_ID : LIVE_BUNDLE_ID
end

# The app a non-build lane acts on: APP_BUNDLE_ID if set, else the variant
# (APP_STORE_VARIANT=YES → live, anything else → beta).
def variant_bundle_id
  return ENV["APP_BUNDLE_ID"] if ENV["APP_BUNDLE_ID"].to_s != ""

  ENV["APP_STORE_VARIANT"] == "YES" ? LIVE_BUNDLE_ID : BETA_BUNDLE_ID
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_API_KEY_ID"],
    issuer_id: ENV["ASC_API_ISSUER_ID"],
    key_content: ENV["ASC_API_KEY_CONTENT"],
    is_key_content_base64: ENV["ASC_API_KEY_CONTENT_IS_BASE64"] == "true",
    in_house: false
  )
end

platform :ios do
  # Local env loading:
  #   fastlane natively auto-loads `fastlane/.env` and `fastlane/.env.default`.
  #   Create `fastlane/.env` from `.env.example` for local runs. The file is
  #   gitignored. CI does not rely on this — it uses GitHub Secrets directly.

  desc "Build the STAGING IPA and upload to TestFlight (env → *-staging Fly apps; sandbox purchases land in staging)."
  lane :beta do
    testflight_build(scheme: "Hangs-Staging", configuration: "Release-Staging")
  end

  desc "Build the PRODUCTION IPA and upload to TestFlight (env → prod Fly apps). Note: TestFlight " \
       "purchases are ALWAYS StoreKit sandbox, so the prod backend gate drops them by design — " \
       "this lane validates the prod app surface, not the money path."
  lane :release do
    testflight_build(scheme: "Hangs-Prod", configuration: "Release-Prod")
  end

  desc "Upload App Store listing metadata only (no binary, no screenshots) from fastlane/metadata. " \
       "Draft copy — founder reviews in ASC before submission."
  lane :metadata do
    ensure_env_vars(
      env_vars: %w[
        ASC_API_KEY_ID
        ASC_API_ISSUER_ID
        ASC_API_KEY_CONTENT
      ]
    )

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_API_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY_CONTENT"],
      is_key_content_base64: ENV["ASC_API_KEY_CONTENT_IS_BASE64"] == "true",
      in_house: false
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end

  private_lane :testflight_build do |options|
    scheme = options[:scheme]
    configuration = options[:configuration]

    ensure_env_vars(
      env_vars: %w[
        ASC_API_KEY_ID
        ASC_API_ISSUER_ID
        ASC_API_KEY_CONTENT
        MATCH_GIT_URL
        MATCH_PASSWORD
      ]
    )

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_API_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY_CONTENT"],
      is_key_content_base64: ENV["ASC_API_KEY_CONTENT_IS_BASE64"] == "true",
      in_house: false
    )

    store_variant = ENV["APP_STORE_VARIANT"] == "YES"
    UI.user_error!("The App Store variant is a production build only.") if store_variant && configuration != "Release-Prod"
    bundle_id = bundle_id_for(configuration: configuration, store_variant: store_variant)
    UI.message("App: #{bundle_id}")

    # #234: the beta app's RevenueCat key ships as a placeholder until the
    # RevenueCat app exists; a beta build with it would have no paywall.
    if bundle_id == BETA_BUNDLE_ID && File.read("../Hangs/Utilities/Config.swift").include?("BETA_KEY_PLACEHOLDER")
      UI.user_error!("Config.revenueCatPublicSDKKeyBeta is still the placeholder (#234 task 234.5).")
    end

    # Sync distribution cert + provisioning profile from the encrypted git repo.
    # readonly on CI prevents the key from accidentally regenerating shared certs,
    # which would invalidate existing installations. Only the app being built:
    # its profile is the one the archive needs.
    match(
      type: "appstore",
      api_key: api_key,
      app_identifier: [bundle_id],
      readonly: true
    )

    # Xcode 16+ installs provisioning profiles under ~/Library/Developer/Xcode/UserData.
    # xcodebuild's manual-signing lookup on CI still consults the legacy path, so
    # mirror the freshly installed profiles to avoid "No profile matching ..." errors.
    require "fileutils"
    legacy_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    new_dir = File.expand_path("~/Library/Developer/Xcode/UserData/Provisioning Profiles")
    FileUtils.mkdir_p(legacy_dir)
    Dir.glob(File.join(new_dir, "*.mobileprovision")).each { |f| FileUtils.cp(f, legacy_dir) }

    # Auto-bump build number relative to what's already in TestFlight, so we never
    # collide with an existing build. Apple's API sometimes reports a lower number
    # than what's actually reserved (invalidated uploads still hold the number),
    # so BUILD_NUMBER_FLOOR lets us nudge past a stuck number when retrying.
    # #234: one counter across the live and the beta app, so the
    # ios/<version>-b<build> tag names exactly one build.
    latest = ALL_BUNDLE_IDS.to_h do |id|
      number = begin
        latest_testflight_build_number(api_key: api_key, app_identifier: id, initial_build_number: 0)
      rescue StandardError => e
        # The other app may not exist in ASC yet; the one being built must.
        raise if id == bundle_id

        UI.important("No TestFlight builds read for #{id} (#{e.message}); counting it as 0.")
        0
      end
      [id, number.to_i]
    end
    tf_latest = latest.values.max
    floor = (ENV["BUILD_NUMBER_FLOOR"] || "0").to_i
    next_build = [tf_latest, floor].max + 1
    UI.message("📦 Build number: tf_latest=#{latest}, floor=#{floor}, next=#{next_build}")

    # Override CURRENT_PROJECT_VERSION on the xcodebuild command line. Command-line
    # build settings have the highest precedence (above xcconfig and target
    # settings), so this reliably wins even with GENERATE_INFOPLIST_FILE=YES,
    # which derives CFBundleVersion from CURRENT_PROJECT_VERSION.
    #
    # Env separation (#101): scheme/configuration always arrive explicitly from the
    # calling lane (`beta` = staging, `release` = prod) — env-critical settings never
    # ride Gymfile ambient defaults.
    #
    # #209: APP_STORE_VARIANT=YES (ios-release.yml input `store: true`) builds the
    # App Store variant: the APP_STORE condition compiles every TestFlight tester
    # surface off, because App Review's sandbox receipt looks like a TestFlight
    # install. Anything else builds the TestFlight variant, unchanged.
    UI.important("App Store variant: tester surfaces compiled off.") if store_variant

    build_app(
      scheme: scheme,
      configuration: configuration,
      export_options: {
        method: "app-store",
        provisioningProfiles: {
          bundle_id => "match AppStore #{bundle_id}"
        },
        signingStyle: "manual",
        teamID: "KAGWHPZZFQ"
      },
      xcargs: "-allowProvisioningUpdates CURRENT_PROJECT_VERSION=#{next_build} APP_STORE_VARIANT=#{store_variant ? 'YES' : 'NO'}"
    )

    # Never distributed to external testers from here, the public beta group
    # included: a store build reaches internal testers only, and an external
    # group gets a build only when someone adds it in App Store Connect.
    upload_to_testflight(
      api_key: api_key,
      app_identifier: bundle_id,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      skip_submission: true
    )

    UI.success("Uploaded #{configuration} #{store_variant ? 'App Store variant' : 'TestFlight'} build #{next_build} to #{bundle_id}.")
  end

  desc "Set export compliance (uses_non_exempt_encryption = false) for the latest TestFlight build " \
       "of one app: bundle_id:<id>, else APP_BUNDLE_ID, else the variant (APP_STORE_VARIANT=YES → live, else beta)."
  lane :set_compliance do |options|
    ensure_env_vars(env_vars: %w[ASC_API_KEY_ID ASC_API_ISSUER_ID ASC_API_KEY_CONTENT])

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_API_ISSUER_ID"],
      key: ENV["ASC_API_KEY_CONTENT"]
    )

    bundle_id = options[:bundle_id] || variant_bundle_id
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    UI.user_error!("App #{bundle_id} not found in App Store Connect.") if app.nil?

    # Primary prevention is the ITSAppUsesNonExemptEncryption=false key in
    # Info.plist — that makes every uploaded build ship with compliance already
    # declared. This lane is a fallback in case that key is ever missing from a
    # build (e.g. mis-edited Info.plist) and a build is sitting in TestFlight
    # as "Missing Compliance".
    builds = app.get_builds(sort: "-uploadedDate", limit: 5)
    target = builds.find { |b| b.uses_non_exempt_encryption.nil? }

    if target.nil?
      UI.success("No builds need compliance — all recent builds already declared.")
      next
    end

    UI.message("Setting usesNonExemptEncryption=false on build #{target.version} (#{target.id}, state=#{target.processing_state})...")
    target.update(attributes: { usesNonExemptEncryption: false })
    UI.success("Build #{target.version} compliance set. TestFlight should flip to 'Ready to Submit' within seconds — refresh the page.")
  end

  desc "Dry-run: verify fastlane config + match access without uploading."
  lane :verify_setup do
    ensure_env_vars(
      env_vars: %w[ASC_API_KEY_ID ASC_API_ISSUER_ID ASC_API_KEY_CONTENT MATCH_GIT_URL MATCH_PASSWORD]
    )

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_API_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY_CONTENT"],
      is_key_content_base64: ENV["ASC_API_KEY_CONTENT_IS_BASE64"] == "true"
    )

    match(type: "appstore", api_key: api_key, app_identifier: [variant_bundle_id], readonly: true)
    UI.success("Match read OK for #{variant_bundle_id}. Cert + profile installed in keychain.")
  end

  # ---------------------------------------------------------------------------
  # A new App ID capability (entitlement): turns it on for the App ID and
  # regenerates the App Store profile so release builds carry it (CI's match
  # is readonly and cannot do this itself). Reuses the existing distribution
  # certificate: builds already uploaded or in review are unaffected. Touches
  # shared signing, so run it only with the founder's OK. Never nukes.
  #
  # Usage:
  #   cd apps/ios-app/Hangs
  #   fastlane ios refresh_appstore_profile capability:ASSOCIATED_DOMAINS
  #   (live app; prefix APP_BUNDLE_ID=com.missinghue.hangs.beta for Trubbo Beta, #234 —
  #   a new capability goes on BOTH apps)
  # ---------------------------------------------------------------------------
  desc "Enable an App ID capability and regenerate the App Store profile."
  lane :refresh_appstore_profile do |options|
    ensure_env_vars(
      env_vars: %w[ASC_API_KEY_ID ASC_API_ISSUER_ID ASC_API_KEY_CONTENT MATCH_GIT_URL MATCH_PASSWORD]
    )

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_API_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY_CONTENT"],
      is_key_content_base64: ENV["ASC_API_KEY_CONTENT_IS_BASE64"] == "true"
    )

    if (capability = options[:capability])
      Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
      bundle_id = Spaceship::ConnectAPI::BundleId.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
      if bundle_id.get_capabilities.any? { |c| c.capability_type == capability }
        UI.message("#{capability} is already on for #{bundle_id.identifier}.")
      else
        bundle_id.create_capability(capability)
        UI.success("#{capability} turned on for #{bundle_id.identifier}.")
      end
    end

    match(type: "appstore", api_key: api_key, app_identifier: [CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)], readonly: false, force: true)
    UI.success("App Store profile regenerated and pushed to the certs repo.")
  end

  # ---------------------------------------------------------------------------
  # #234 — Trubbo Beta, task 234.2: register the beta Bundle ID and create its
  # match profiles (App Store + development). Run LOCALLY, once, with the
  # founder's OK (touches shared signing; reuses the existing distribution
  # certificate, never nukes). Not run by any workflow.
  #
  #   cd apps/ios-app/Hangs
  #   bundle exec fastlane ios register_beta_app
  #
  # What the API cannot do (do it in the developer portal afterwards):
  #   · Sign in with Apple grouping: the API turns the capability on as a
  #     PRIMARY App ID. Grouping the beta under com.missinghue.hangs is set in
  #     developer.apple.com → Identifiers → com.missinghue.hangs.beta → Sign In
  #     with Apple → Edit → "Group with an existing primary App ID". Then rerun
  #     this lane with force_profiles:true so the profiles pick it up.
  #   · The App Store Connect app record ("Trubbo Beta"): Apple allows it in
  #     the ASC web UI only (founder step 234.3).
  # ---------------------------------------------------------------------------
  desc "One-time (#234): register com.missinghue.hangs.beta (Sign in with Apple + Associated Domains) " \
       "and create its match App Store + development profiles."
  lane :register_beta_app do |options|
    UI.user_error!("Run register_beta_app locally, not on CI.") if ENV["CI"]

    ensure_env_vars(
      env_vars: %w[ASC_API_KEY_ID ASC_API_ISSUER_ID ASC_API_KEY_CONTENT MATCH_GIT_URL MATCH_PASSWORD]
    )
    api_key = asc_api_key
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

    bundle_id = Spaceship::ConnectAPI::BundleId.find(BETA_BUNDLE_ID)
    if bundle_id.nil?
      bundle_id = Spaceship::ConnectAPI::BundleId.create(
        name: "Trubbo Beta",
        platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
        identifier: BETA_BUNDLE_ID
      )
      UI.success("Registered #{BETA_BUNDLE_ID}.")
    else
      UI.message("#{BETA_BUNDLE_ID} is already registered.")
    end

    enabled = bundle_id.get_capabilities.map(&:capability_type)
    %w[APPLE_ID_AUTH ASSOCIATED_DOMAINS].each do |capability|
      next UI.message("#{capability} is already on.") if enabled.include?(capability)

      bundle_id.create_capability(capability)
      UI.success("#{capability} turned on for #{BETA_BUNDLE_ID}.")
    end
    UI.important("Sign in with Apple is now a primary App ID; group it under #{LIVE_BUNDLE_ID} in the developer portal (see lane comment).")

    force = options[:force_profiles] == true || options[:force_profiles].to_s == "true"
    %w[appstore development].each do |type|
      match(type: type, api_key: api_key, app_identifier: [BETA_BUNDLE_ID], readonly: false, force: force)
    end
    UI.success("match AppStore + Development profiles for #{BETA_BUNDLE_ID} pushed to the certs repo.")
  end

  # ---------------------------------------------------------------------------
  # One-time bootstrap lane — run LOCALLY (not on CI) to create the initial
  # distribution certificate and App Store provisioning profile and push them
  # encrypted into the certs repo. Requires ADMIN or APP MANAGER API key role.
  #
  # Usage:
  #   cd apps/ios-app/Hangs
  #   bundle exec fastlane ios bootstrap_certs
  # ---------------------------------------------------------------------------
  desc "One-time: create distribution cert + profile and push to certs repo."
  lane :bootstrap_certs do
    UI.important("This will create a NEW distribution certificate if none exists.")
    UI.important("Run this ONCE per app. Running it again with force=true will invalidate existing certs.")

    ensure_env_vars(
      env_vars: %w[ASC_API_KEY_ID ASC_API_ISSUER_ID ASC_API_KEY_CONTENT MATCH_GIT_URL MATCH_PASSWORD]
    )

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_API_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY_CONTENT"]
    )

    # NOT readonly — this run generates the cert + profile if missing.
    match(
      type: "appstore",
      api_key: api_key,
      readonly: false
    )

    UI.success("Cert + profile created and pushed (encrypted) to #{ENV['MATCH_GIT_URL']}.")
  end

  # ---------------------------------------------------------------------------
  # Destructive — revokes ALL certs/profiles for this app. Only use if certs
  # have leaked or you want a clean slate. Requires confirmation.
  # ---------------------------------------------------------------------------
  desc "DESTRUCTIVE: revoke all distribution certs and profiles for this app."
  lane :nuke_certs do
    UI.user_error!("Refusing to run nuke_certs on CI.") if ENV["CI"]

    confirm = UI.input("Type 'NUKE' to confirm revocation:")
    UI.user_error!("Aborted.") unless confirm == "NUKE"

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_API_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY_CONTENT"]
    )

    match_nuke(type: "distribution", api_key: api_key)
  end
end
