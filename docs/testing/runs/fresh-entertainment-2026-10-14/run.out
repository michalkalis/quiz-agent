"source_url": "https://guinnessworldrecords.com/world-records/107048-first-video-to-receive-one-billion-views", "source_excerpt": "Gangnam Style became the first video to receive one billion views on YouTube on 21 December 2012, with 1,000,382,639 views.", "usage_count": 0, "user_ratings": {}, "review_status": "approved", "reviewed_by": "machine:gates-v1", "reviewed_at": "2026-10-14T11:09:26.865883Z", "review_notes": null, "quality_ratings": null, "generation_metadata": {"model": "claude-opus-5-5", "provider": "anthropic", "prompt_version": "direct_v1", "pipeline": null, "generation_flow": "fun-redesign-72", "generation_temperature": null, "critique_model": null, "critique_score": null, "reasoning_pattern": "year_guess", "fact_ids": [], "extra": {"stage": "initial_generation", "escape_hatch": true, "gen_craft_guards": true, "why_interesting": "The horse-dance craze feels like it took years to build up, but it hit a billion views in the same year it came out. Most players remember the dance and can reason their way to the year.", "topicality": {"tier": "none", "event_date": null, "rationale": "Internet history from 2012, no fresher today than any other time."}, "factcheck_tier": "web", "verified": true, "verification_score": 0.9, "verification_notes": "Guinness World Records confirms Gangnam Style was the first video to reach 1 billion YouTube views, on 21 December 2012."}, "created_at": null}, "cost_cents": null, "media_url": null, "image_subtype": null, "media_duration_seconds": null, "explanation": "It got there in December 2012, less than six months after release, and the counter racing past the billion became a news event of its own.", "embedding_model": "text-embedding-3-small", "embedding_dim": 1536, "subtopic": null, "answer_key": null, "embedding_qa_model": "text-embedding-3-small", "expires_at": null, "freshness_tag": null, "boost_until": null}, {"id": "4394f565-1e20-4ee7-ae17-18efcc372996", "question": "In the early seasons of Friends, palaeontologist Ross keeps an unusual pet in his New York apartment, until it ends up at San Diego Zoo. What kind of animal is it?", "type": "text", "possible_answers": null, "correct_answer": "A monkey", "alternative_answers": ["Monkey", "Capuchin monkey", "Capuchin", "Marcel the monkey"], "headline_answer": null, "topic": "TV & streaming", "category": "entertainment", "difficulty": "medium", "tags": [], "language_dependent": false, "age_appropriate": "all", "language": "en", "pack_id": null, "prompt_seed": "af636849077fb5c0", "created_at": "2026-10-14T13:07:44.668987", "created_by": null, "source": "generated", "source_url": "https://en.wikipedia.org/wiki/Marcel_(Friends)", "source_excerpt": "Marcel is a capuchin monkey who was Ross Geller's pet in the sitcom Friends.", "usage_count": 0, "user_ratings": {}, "review_status": "approved", "reviewed_by": "machine:gates-v1", "reviewed_at": "2026-10-14T11:09:26.865883Z", "review_notes": null, "quality_ratings": null, "generation_metadata": {"model": "claude-opus-5-5", "provider": "anthropic", "prompt_version": "direct_v1", "pipeline": null, "generation_flow": "fun-redesign-72", "generation_temperature": null, "critique_model": null, "critique_score": null, "reasoning_pattern": "forgotten_detail", "fact_ids": [], "extra": {"stage": "initial_generation", "escape_hatch": true, "gen_craft_guards": true, "why_interesting": "Friends is remembered as six people on a sofa in a coffee shop, and many casual fans forget that the sensible palaeontologist once kept an exotic pet in a New York flat.", "topicality": {"tier": "none", "event_date": null, "rationale": "Plot detail from a 1990s sitcom, evergreen trivia."}, "factcheck_tier": "web", "verified": true, "verification_score": 0.9, "verification_notes": "Ross's pet is Marcel, a capuchin monkey, who is sent to San Diego Zoo, as the question describes (checked from memory, not by search)."}, "created_at": null}, "cost_cents": null, "media_url": null, "image_subtype": null, "media_duration_seconds": n