eration_flow": "fun-redesign-72", "generation_temperature": null, "critique_model": null, "critique_score": null, "reasoning_pattern": "hidden_background", "fact_ids": [], "extra": {"stage": "initial_generation", "escape_hatch": true, "gen_craft_guards": true, "why_interesting": "Players know her as a Czech pop star and judge. Many have never thought about her roots, but the spelling 'Ewa' and her Těšín origins give a fair path to the answer. The payoff is that she is just as big a star in Poland.", "topicality": {"tier": "quarter", "event_date": "2026-09-01", "rationale": "The answer (Polish) is evergreen, but the hook is Farna joining the revived SuperStar jury, which stays topical for about one TV season."}, "factcheck_tier": "web", "verified": true, "verification_score": 0.7, "verification_notes": "Farna je z polské menšiny ve Vendryni, chodila do polských škol, vydala polské verze alb a v září 2026 zasedla v porotě SuperStar; domácí jazyk (těšínské nářečí/polština) není výslovně citován, ale polsky je obhajitelné."}, "created_at": null}, "cost_cents": null, "media_url": null, "image_subtype": null, "media_duration_seconds": null, "explanation": "Ewa Farna pochází z polské menšiny na Těšínsku a vyrůstala ve Vendryni u Třince. Vydává alba česky i polsky, a tak je v Polsku stejně velkou hvězdou jako u nás.", "embedding_model": "text-embedding-3-small", "embedding_dim": 1536, "subtopic": null, "answer_key": null, "embedding_qa_model": "text-embedding-3-small", "expires_at": null, "freshness_tag": null, "boost_until": "2026-11-30T00:00:00Z"}]}}, "spent_usd": 0.7102}
