{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "\"Repeat\" and \"next\" work while the question is read, on the iPhone speaker or a hands-free call route. The question then plays at call volume" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zopakuj“ a „další“ fungují i během čtení otázky, na reproduktoru iPhonu nebo při hands-free hovoru. Otázka pak hraje hlasitostí hovoru"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zopakuj“ a „ďalšia“ fungujú aj počas čítania otázky, na reproduktore iPhonu alebo pri hands-free hovore. Otázka potom hrá hlasitosťou hovoru"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Повтори» і «пропусти» працюють і під час читання питання, на динаміку iPhone або під час дзвінка через гарнітуру. Питання тоді звучить з гучністю дзвінка"
          }
        }
      }
    },
