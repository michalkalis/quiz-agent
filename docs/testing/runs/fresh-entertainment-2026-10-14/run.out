tings": null, "generation_metadata": {"model": "claude-opus-5-5", "provider": "anthropic", "prompt_version": "direct_v1", "pipeline": null, "generation_flow": "fun-redesign-72", "generation_temperature": null, "critique_model": null, "critique_score": null, "reasoning_pattern": "plain_knowledge", "fact_ids": [], "extra": {"stage": "initial_generation", "escape_hatch": true, "gen_craft_guards": true, "why_interesting": "The general's name may sound unfamiliar, but Banská Bystrica and 1944 lead every Slovak player straight to the nation's best-known historical event.", "topicality": {"tier": "none", "event_date": null, "rationale": "Answer is the 1944 Slovak National Uprising; film announcement is only a hook for a history question."}, "factcheck_tier": "web", "verified": true, "verification_score": 0.9, "verification_notes": "Golian led the military forces of the Slovak National Uprising centred in Banská Bystrica; the film (Generál Golian) premiered in 2026, per https://cinematik.sk/en/the-21st-edition-of-mff-cinematik-opens-with-the-world-premiere-of-the-historical-drama-general-golian"}, "created_at": null}, "cost_cents": null, "media_url": null, "image_subtype": null, "media_duration_seconds": null, "explanation": "Generál Golian bol vojenským veliteľom SNP. Po potlačení povstania ho zajali Nemci a domov sa už nikdy nevrátil.", "embedding_model": "text-embedding-3-small", "embedding_dim": 1536, "subtopic": null, "answer_key": null, "embedding_qa_model": "text-embedding-3-small", "expires_at": null, "freshness_tag": null, "boost_until": null}, {"id": "c7750d6a-de60-491c-959b-0a03360225cf", "question": "Speváčka Kristína v roku 2010 reprezentovala Slovensko na Eurovízii s hitom, ktorý ospevuje kraj okolo horného toku jednej slovenskej rieky. Ako sa táto pieseň volá?", "type": "text", "possible_answers": null, "correct_answer": "Horehronie", "alternative_answers": [], "headline_answer": null, "topic": "Slovenská hudba", "category": "entertainment", "difficulty": "easy", "tags": [], "language_dependent": false, "age_appropriate": "all", "language": "sk", "pack_id": null, "prompt_seed": "e143544a32a2cef5", "created_at": "2026-10-14T13:14:28.174717", "created_by": null, "source": "generated", "source_url": "https://en.wikipedia.org/wiki/Slovakia_in_the_Eurovision_Song_Contest_2010", "source_excerpt": "Kristina represented Slovakia with the song \"Horehronie\" at the Eurovision Song Contest 2010.", "usage_count": 0, "user_ratings": {}, "review_status": "approved", "reviewed_by": "machine:gates-v1", "reviewed_at": "2026-10-14T11:19:28.866246Z", "review_notes": null, "quality_ratings": null, "generation_metadata": {"model": "claude-opus-5-5", "provider": "anthropic", "prompt_version": "direct_v1", "pipeline": null, "generation_flow": "fun-redesign-72", "generation_temperature": null, "critique_model": null, "critique_score": null, "reasoning_pattern": "description_to_name", "fact_ids": [], "extra": {"stage": "initial_generation", "escape_hatch": true, "gen_craft_guards": true, "why_interesting": "Almost everyone hummed this song, and the stem describes the region instead of naming it, so the player has to make the jump to the title.", "topicality": {"tier": "none", "event_date": null, "rationale": "2010 Eurovision entry is settled music history."}, "factcheck_tier": "web", "verified": true, "verification_score": 0.9, "verification_notes": "Kristina represented Slovakia at Eurovision 2010 with 'Horehronie', named for the upper Hron region; no contradicting or newer information found."}, "created_at": null}, "cost_cents": null, "media_url": null, "image_subtype": null, "media_duration_seconds": null, "explanation": "Na Eurovízii v Osle sa Horehronie do finále neprebojovalo, no doma sa z neho stal jeden z najhranejších hitov roka.", "embedding_model": "text-embedding-3-small", "embedding_dim": 1536, "subtopic": null, "answer_key": null, "embedding_qa_model": "text-embedding-3-small", "expires_at": null, "freshness_tag": null, "boost_until": null}, {"id": "f885e69f-2d94-4150-9163-5e6ea7df06a6", "question": "Čarovnú Perinbabu, ktorá vytriasaním periny posiela na zem sneh, hrala v rozprávke z roku 1985 svetoznáma zahraničná herečka, manželka Federica Felliniho. Z ktorej krajiny pochádzala?", "type": "text", "possible_answers": null, "correct_answer": "Z Talianska", "alternative_answers": ["Taliansko", "Itália"], "headline_answer": null, "topic": "Slovenské rozprávky", "category": "entertainment", "difficulty": "medium", "tags": [], "language_dependent": false, "age_appropriate": "all", "language": "sk", "pack_id": null, "prompt_seed": "e143544a32a2cef5", "created_at": "2026-10-14T13:14:28.174746", "created_by": null, "source": "generated", "source_url": "https://m.imdb.com/name/nm0556399", "source_excerpt": "Perinbaba, Lady Winter, 1985", "usage_count": 0, "user_ratings": {}, "review_status": "approved", "reviewed_by": "machine:gates-v1", "reviewed_at": "2026-10-14T11:19:28.866246Z", "review_notes": null, "quality_ratings": null, "generation_metadata": {"model": "claude-opus-5-5", "provider": "anthropic", "prompt_version": "direct_v1", "pipeline": null, "generation_flow": "fun-redesign-72", "generation_temperature": null, "critique_model": null, "critique_score": null, "reasoning_pattern": "surprising_casting", "fact_ids": [], "extra": {"stage": "initial_generation", "escape_hatch": true, "gen_craft_guards": true, "why_interesting": "Perinbaba feels like a purely Slovak Christmas classic, so few players realise a foreign star played the title role. The Fellini clue makes the country reachable.", "topicality": {"tier": "none", "event_date": null, "rationale": "1985 fairy-tale casting trivia, general culture."}, "factcheck_tier": "web", "verified": true, "verification_score": 0.9, "verification_notes": "Giulietta Masina (Italian, Fellini's wife) played the title role of Perinbaba/Lady Winter in the 1985 film, per https://m.imdb.com/name/nm0556399."}, "created_at": null}, "cost_cents": null, "media_url": null, "image_subtype": null, "media_duration_seconds": null, "explanation": "Perinbabu hrala Talianka Giulietta Masina. Slovenská zimná rozprávka tak mala v hlavnej úlohe hviezdu talianskeho filmu.", "embedding_model": "text-embedding-3-small", "embedding_dim": 1536, "subtopic": null, "answer_key": null, "embedding_qa_model": "text-embedding-3-small", "expires_at": null, "freshness_tag": null, "boost_until": null}, {"id": "9eb87f16-7b45-47f4-817c-eb57f95abf62", "question": "Ktorý slovenský herec stvárnil dobráckeho tesára Tóna Brtka v slávnom filme Obchod na korze z roku 1965?", "type": "text_multichoice", "possible_answers": {"a": "Ladislav Chudík", "b": "Jozef Kroner", "c": "Marián Labuda", "d": "Július Pántik"}, "correct_answer": "Jozef Kroner", "alternative_answers": [], "headline_answer": null, "topic": "Slovenský film", "category": "entertainment", "difficulty": "medium", "tags": [], "language_dependent": false, "age_appropriate": "all", "language": "sk", "pack_id": null, "prompt_seed": "e143544a32a2cef5", "created_at": "2026-10-14T13:14:28.174755", "created_by": null, "source": "generated", "source_url": "https://en.wikipedia.org/wiki/The_Shop_on_Main_Street", "source_excerpt": "Tóno Brtko is played by Jozef Kroner", "usage_count": 0, "user_ratings": {}, "review_status": "approved", "reviewed_by": "machine:gates-v1", "reviewed_at": "2026-10-14T11:19:28.866246Z", "review_notes": null, "quality_ratings": null, "generation_metadata": {"model": "claude-opus-5-5", "provider": "anthropic", "prompt_version": "direct_v1", "pipeline": null, "generation_flow": "fun-redesign-72", "generation_temperature": null, "critique_model": null, "critique_score": null, "reasoning_pattern": "multiple_choice", "fact_ids": [], "extra": {"stage": "initial_generation", "escape_hatch": true, "gen_craft_guards": true, "why_interesting": "Everyone has heard of the film, but many hesitate on its lead. Four famous Slovak actors of the same generation make it a real test of half-memory.", "topicality": {"tier": "none", "event_date": null, "rationale": "Classic 1965 film casting, film history."}, "factcheck_tier": "web", "verified": true, "verification_score": 0.9, "verification_notes": "Wikipedia confirms Jozef Kroner played the mild-mannered carpenter Tóno Brtko in the 1965 film."}, "created_at": null}, "cost_cents": null, "media_url": null, "image_subtype": null, "media_duration_seconds": null, "explanation": "Tóna Brtka hral Jozef Kroner. Práve vďaka tejto úlohe o obyčajnom človeku v neľudskej dobe sa stal hereckou legendou.", "embedding_model": "text-embedding-3-small", "embedding_dim": 1536, "subtopic": null, "answer_key": null, "embedding_qa_model": "text-embedding-3-small", "expires_at": null, "freshness_tag": null, "boost_until": null}, {"id": "f87d0a2e-0ef3-4457-8208-6e2bd4344595", "question": "S ktorým hercom tvoril Milan Lasica legendárnu komickú dvojicu, ktorá od šesťdesiatych rokov bavila divákov na Slovensku aj v Česku?", "type": "text", "possible_answers": null, "correct_answer": "Július Satinský", "alternative_answers": ["Satinský", "Jula Satinský"], "headline_answer": null, "topic": "Slovenský humor", "category": "entertainment", "difficulty": "easy", "tags": [], "language_dependent": false, "age_appropriate": "all", "language": "sk", "pack_id": null, "prompt_seed": "e143544a32a2cef5", "created_at": "2026-10-14T13:14:28.174811", "created_by": null, "source": "generated", "source_url": "https://ct24.ceskatelevize.cz/clanek/kultura/zemrel-milan-lasica-profesni-zivot-stravil-vedle-satinskeho-znaly-ho-cele-generace-31497", "source_excerpt": "Ve dvojici s Júliem Satinským hrál Lasica přes padesát let.", "usage_count": 0, "user_ratings": {}, "review_status": "approved", "reviewed_by": "machine:gates-v1", "reviewed_at": "2026-10-14T11:19:28.866246Z", "review_notes": null, "quality_ratings": null, "generation_metadata": {"model": "claude-opus-5-5", "provider": "anthropic", "prompt_version": "direct_v1", "pipeline": null, "generation_flow": "fun-redesign-72", "generation_temperature": null, "critique_model": null, "critique_score": null, "reasoning_pattern": "plain_knowledge", "fact_ids": [], "extra": {"stage": "initial_generation", "escape_hatch": true, "gen_craft_guards": true, "why_interesting": "A warm, widely known pairing. It is easy, but it rewards Slovak players who grew up on their dialogues.", "topicality": {"tier": "none", "event_date": null, "rationale": "Legendary comedy duo, cultural history."}, "factcheck_tier": "web", "verified": true, "verification_score": 0.9, "verification_notes": "Lasica and Satinský were a comedy duo from the 1960s, as confirmed by ČT24's obituary of Lasica (https://ct24.ceskatelevize.cz/clanek/kultura/zemrel-milan-lasica-profesni-zivot-stravil-vedle-satinskeho-znaly-ho-cele-generace-31497)."}, "created_at": null}, "cost_cents": null, "media_url": null, "image_subtype": null, "media_duration_seconds": null, "explanation": "Lasica a Satinský sa preslávili absurdným humorom a dialógmi. Ich meno sa dodnes vyslovuje ako jedno slovo.", "embedding_model": "text-embedding-3-small", "embedding_dim": 1536, "subtopic": null, "answer_key": null, "embedding_qa_model": "text-embedding-3-small", "expires_at": null, "freshness_tag": null, "boost_until": null}, {"id": "041eb080-6694-4956-8ddc-37be0c599497", "question": "V komédii Sám doma Kevin odplaší doručovateľa pizze aj zlodejov ukážkou zo starého čiernobieleho gangsterského filmu Angels with Filthy Souls. Čo je na tomto filme prekvapivé?", "type": "text", "possible_answers": null, "correct_answer": "V skutočnosti neexistuje", "alternative_answers": ["Neexistuje", "Natočili ho len pre Sám doma", "Je vymyslený", "Je to fiktívny film"], "headline_answer": null, "topic": "Svetové filmy", "category": "entertainment", "difficulty": "medium", "tags": [], "language_dependent": false, "age_appropriate": "all", "language": "sk", "pack_id": null, "prompt_seed": "e143544a32a2cef5", "created_at": "2026-10-14T13:14:28.174853", "created_by": null, "source": "generated", "source_url": "https://www.snopes.com/fact-check/home-alone-fake-movie/", "source_excerpt": "it doesn't exist", "usage_count": 0, "user_ratings": {}, "review_status": "approved", "reviewed_by": "machine:gates-v1", "reviewed_at": "2026-10-14T11:19:28.866246Z", "review_notes": null, "quality_ratings": null, "generation_metadata": {"model": "claude-opus-5-5", "provider": "anthropic", "prompt_version": "direct_v1", "pipeline": null, "generation_flow": "fun-redesign-72", "generation_temperature": null, "critique_model": null, "critique_score": null, "reasoning_pattern": "hidden_truth", "fact_ids": [], "extra": {"stage": "initial_generation", "escape_hatch": true, "gen_craft_guards": true, "why_interesting": "Generations of Slovaks have watched it every Christmas and assumed the clip came from a real old movie. A player can reason that something about it is 'fake'.", "topicality": {"tier": "none", "event_date": null, "rationale": "Home Alone movie trivia, evergreen pop culture."}, "factcheck_tier": "web", "verified": true, "verification_score": 0.9, "verification_notes": "Angels with Filthy Souls is a fictional film created for Home Alone, so 'it doesn't actually exist' is correct (https://www.snopes.com/fact-check/home-alone-fake-movie/)."}, "created_at": null}, "cost_cents": null, "media_url": null, "image_subtype": null, "media_duration_seconds": null, "explanation": "Gangsterku natočili len pre Sám doma ako paródiu na staré filmy. Ako celý film nikdy nevznikla.", "embedding_model": "text-embedding-3-small", "embedding_dim": 1536, "subtopic": null, "answer_key": null, "embedding_qa_model": "text-embedding-3-small", "expires_at": null, "freshness_tag": null, "boost_until": null}, {"id": "9e6d67aa-8352-4b96-8355-1d7d228af74f", "question": "Zelený vybuchujúci Creeper, najslávnejšia príšera z Minecraftu, vznikol omylom. Autor hry pri modelovaní pomýlil výšku a dĺžku jedného domáceho zvieraťa. Ktorého?", "type": "text", "possible_answers": null, "correct_answer": "Prasaťa", "alternative_answers": ["Prasa", "Prasiatko", "Ošípaná", "Sviňa"], "headline_answer": null, "topic": "Videohry", "category": "entertainment", "difficulty": "medium", "tags": [], "language_dependent": false, "age_appropriate": "all", "language": "sk", "pack_id": null, "prompt_seed": "e143544a32a2cef5", "created_at": "2026-10-14T13:14:28.174863", "created_by": null, "source": "generated", "source_url": "https://en.wikipedia.org/wiki/Creeper_(Minecraft)", "source_excerpt": "coding error when creating the pig mob... Persson accidentally mixed up the dimensions of the model, swapping the length and height.", "usage_count": 0, "user_ratings": {}, "review_status": "approved", "reviewed_by": "machine:gates-v1", "reviewed_at": "2026-10-14T11:19:28.866246Z", "review_notes": null, "quality_ratings": null, "generation_metadata": {"model": "claude-opus-5-5", "provider": "anthropic", "prompt_version": "direct_v1", "pipeline": null, "generation_flow": "fun-redesign-72", "generation_temperature": null, "critique_model": null, "critique_score": null, "reasoning_pattern": "accidental_origin", "fact_ids": [], "extra": {"stage": "initial_generation", "escape_hatch": true, "gen_craft_guards": true, "why_interesting": "The game's most iconic monster was born from a botched farm animal. Players can reason from the Creeper's four short legs to a four-legged animal.", "topicality": {"tier": "none", "event_date": null, "rationale": "Minecraft Creeper origin story, evergreen gaming trivia."}, "factcheck_tier": "web", "verified": true, "verification_score": 0.9, "verification_notes": "Wikipedia confirms Notch swapped the pig model's height and length, which produced the creeper."}, "created_at": null}, "cost_cents": null, "media_url": null, "image_subtype": null, "media_duration_seconds": null, "explanation": "Namiesto dlhého nízkeho prasaťa vyšla vysoká postavička na štyroch nožičkách. Autorovi sa zapáčila, dal jej zelenú farbu a bola z nej legenda.", "embedding_model": "text-embedding-3-small", "embedding_dim": 1536, "subtopic": null, "answer_key": null, "embedding_qa_model": "text-embedding-3-small", "expires_at": null, "freshness_tag": null, "boost_until": null}, {"id": "67341d30-a8f9-43fb-8f33-9047597663fc", "question": "Mr. Bean svoje malé zelené auto Mini nezamyká kľúčom ako ostatní ľudia. Čím ho zabezpečí?", "type": "text", "possible_answers": null, "correct_answer": "Visiacim zámkom", "alternative_answers": ["Visiak", "Visiaci zámok", "Zámkom na dverách", "Lacným zámkom"], "headline_answer": null, "topic": "Komédie", "category": "entertainment", "difficulty": "medium", "tags": [], "language_dependent": false, "age_appropriate": "all", "language": "sk", "pack_id": null, "prompt_seed": "e143544a32a2cef5", "created_at": "2026-10-14T13:14:28.174874", "created_by": null, "source": "generated", "source_url": "https://joeduffy.ie/mini/news/mr-beans-mini", "source_excerpt": "Mr. Bean fitted the door with a bolt-latch and padlock, rather than use the lock fitted on the car.", "usage_count": 0, "user_ratings": {}, "review_status": "approved", "reviewed_by": "machine:gates-v1", "reviewed_at": "2026-10-14T11:19:28.866246Z", "review_notes": null, "quality_ratings": null, "generation_metadata": {"model": "claude-opus-5-5", "provider": "anthropic", "prompt_version": "direct_v1", "pipeline": null, "generation_flow": "fun-redesign-72", "generation_temperature": null, "critique_model": null, "critique_score": null, "reasoning_pattern": "visual_memory", "fact_ids": [], "extra": {"stage": "initial_generation", "escape_hatch": true, "gen_craft_guards": true, "why_interesting": "Many players half-remember the gag, and those who don't can reason that the joke must be an absurdly low-tech lock.", "topicality": {"tier": "none", "event_date": null, "rationale": "Mr. Bean gag, evergreen pop culture."}, "factcheck_tier": "web", "verified": true, "verification_score": 0.7, "verification_notes": "Sources say Bean fitted a bolt-latch and padlock to the Mini's door rather than using the factory lock, which matches the answer; no newer developments found."}, "created_at": null}, "cost_cents": null, "media_url": null, "image_subtype": null, "media_duration_seconds": null, "explanation": "Na dverách má pripevnený obyčajný visiaci zámok. Pre istotu si navyše so sebou berie aj volant.", "embedding_model": "text-embedding-3-small", "embedding_dim": 1536, "subtopic": null, "answer_key": null, "embedding_qa_model": "text-embedding-3-small", "expires_at": null, "freshness_tag": null, "boost_until": null}, {"id": "9fa5b6a8-dbb1-4358-8805-67c517d2535d", "question": "V Impérium vracia úder Darth Vader v skutočnosti nikdy nepovie slávne „Luke, ja som tvoj otec“. Ktorým slovom sa jeho skutočná veta začína?", "type": "text", "possible_answers": null, "correct_answer": "Nie", "alternative_answers": ["No"], "headline_answer": null, "topic": "Svetové filmy", "category": "entertainment", "difficulty": "medium", "tags": [], "language_dependent": false, "age_appropriate": "all", "language": "sk", "pack_id": null, "prompt_seed": "e143544a32a2cef5", "created_at": "2026-10-14T13:14:28.174884", "created_by": null, "source": "generated", "source_url": "https://www.today.com/today/amp/rcna170438", "source_excerpt": "James Earl Jones ... never actually said 'Luke, I am your father'; the actual line is 'No, I am your father.'", "usage_count": 0, "user_ratings": {}, "review_status": "approved", "reviewed_by": "machine:gates-v1", "reviewed_at": "2026-10-14T11:19:28.866246Z", "review_notes": null, "quality_ratings": null, "generation_metadata": {"model": "claude-opus-5-5", "provider": "anthropic", "prompt_version": "direct_v1", "pipeline": null, "generation_flow": "fun-redesign-72", "generation_temperature": null, "critique_model": null, "critique_score": null, "reasoning_pattern": "famous_misquote", "fact_ids": [], "extra": {"stage": "initial_generation", "escape_hatch": true, "gen_craft_guards": true, "why_interesting": "Everyone 'knows' the line, and almost everyone misquotes it. The player has to replay the scene in their head, where Luke has just accused Vader of killing his father.", "topicality": {"tier": "none", "event_date": null, "rationale": "Famous Star Wars misquote, evergreen film trivia."}, "factcheck_tier": "web", "verified": true, "verification_score": 0.9, "verification_notes": "Vader's actual line is 'No, I am your father', so 'Nie' is correct (https://www.today.com/today/amp/rcna170438)."}, "created_at": null}, "cost_cents": null, "media_url": null, "image_subtype": null, "media_duration_seconds": null, "explanation": "Luke kričí, že Vader zabil jeho otca, a Vader odpovie: „Nie. Ja som tvoj otec.“ Meno Luke v tej vete vôbec nezaznie.", "embedding_model": "text-embedding-3-small", "embedding_dim": 1536, "subtopic": null, "answer_key": null, "embedding_qa_model": "text-embedding-3-small", "expires_at": null, "freshness_tag": null, "boost_until": null}, {"id": "f91fd098-5dc4-4a78-b883-692546bd05bd", "question": "V slovenskej rozprávke z roku 1982 povie najmladšia princezná kráľovi otcovi, že ho má rada ako jednu obyčajnú kuchynskú prísadu. Urazený kráľ ju vyženie z hradu. Ako sa táto rozprávka volá?", "type": "text", "possible_answers": null, "correct_answer": "Soľ nad zlato", "alternative_answers": ["Sol nad zlato"], "headline_answer": null, "topic": "Slovenské rozprávky", "category": "entertainment", "difficulty": "easy", "tags": [], "language_dependent": false, "age_appropriate": "all", "language": "sk", "pack_id": null, "prompt_seed": "e143544a32a2cef5", "created_at": "2026-10-14T13:17:10.852162", "created_by": null, "source": "generated", "source_url": "https://en.wikipedia.org/wiki/The_Salt_Prince", "source_excerpt": "The youngest, Maruška, says she loves him more than salt, which is necessary for life. He is offended and banishes her.", "usage_count": 0, "user_ratings": {}, "review_status": "approved", "reviewed_by": "machine:gates-v1", "reviewed_at": "2026-10-14T11:19:28.866246Z", "review_notes": null, "quality_ratings": null, "generation_metadata": {"model": "claude-opus-5-5", "provider": "anthropic", "prompt_version": "direct_v1", "pipeline": null, "generation_flow": "fun-redesign-72", "generation_temperature": null, "critique_model": null, "critique_score": null, "reasoning_pattern": "plot_to_title", "fact_ids": [], "extra": {"stage": "initial_generation", "escape_hatch": true, "gen_craft_guards": true, "why_interesting": "It is a beloved Christmas-TV staple. The stem describes the famous scene without naming the ingredient, so the player gets an 'of course' moment when the title clicks.", "topicality": {"tier": "none", "event_date": null, "rationale": "Classic 1982 fairy-tale film trivia; general culture, not topical."}, "factcheck_tier": "web", "verified": true, "verification_score": 0.7, "verification_notes": "The plot (youngest daughter loves father like salt, banished) matches Soľ nad zlato by Martin Hollý; the year is 1982 by production date and 1983 by release date, per Wikipedia and the Zlín archive."}, "created_at": null}, "cost_cents": null, "media_url": null, "image_subtype": null, "media_duration_seconds": null, "explanation": "Kráľ najprv považuje soľ za bezcennú urážku. Keď však z kráľovstva zmizne, pochopí, že je vzácnejšia než všetko zlato.", "embedding_model": "text-embedding-3-small", "embedding_dim": 1536, "subtopic": null, "answer_key": null, "embedding_qa_model": "text-embedding-3-small", "expires_at": null, "freshness_tag": null, "boost_until": null}, {"id": "99509716-693e-4c86-8910-9fb148c471af", "question": "Mario dnes každý pozná ako inštalatéra. V hre Donkey Kong z roku 1981 sa však volal Jumpman a pobehoval po stavbe s oceľovými nosníkmi. Aké remeslo mal vtedy?", "type": "text", "possible_answers": null, "correct_answer": "Tesár", "alternative_answers": ["Stolár", "Robotník na stavbe", "Stavbár"], "headline_answer": null, "topic": "Videohry", "category": "entertainment", "difficulty": "medium", "tags": [], "language_dependent": false, "age_appropriate": "all", "language": "sk", "pack_id": null, "prompt_seed": "e143544a32a2cef5", "created_at": "2026-10-14T13:17:10.852185", "created_by": null, "source": "generated", "source_url": "https://www.denofgeek.com/games/mario-plumber-nintendo-history-background-explained/", "source_excerpt": "the game's stage was a construction site, so we made him into basically a carpenter.", "usage_count": 0, "user_ratings": {}, "review_status": "approved", "reviewed_by": "machine:gates-v1", "reviewed_at": "2026-10-14T11:19:28.866246Z", "review_notes": null, "quality_ratings": null, "generation_metadata": {"model": "claude-opus-5-5", "provider": "anthropic", "prompt_version": "direct_v1", "pipeline": null, "generation_flow": "fun-redesign-72", "generation_temperature": null, "critique_model": null, "critique_score": null, "reasoning_pattern": "origin_twist", "fact_ids": [], "extra": {"stage": "initial_generation", "escape_hatch": true, "gen_craft_guards": true, "why_interesting": "Everyone 'knows' Mario is a plumber. The setting of his first game, a construction site with steel girders, gives a reasoning path to his original trade.", "topicality": {"tier": "none", "event_date": null, "rationale": "Video game history from 1981; timeless trivia."}, "factcheck_tier": "web", "verified": true, "verification_score": 0.9, "verification_notes": "Jumpman in Donkey Kong (1981) was a carpenter per Miyamoto; the plumber role came with Mario Bros. (https://www.denofgeek.com/games/mario-plumber-nintendo-history-background-explained/)."}, "created_at": null}, "cost_cents": null, "media_url": null, "image_subtype": null, "media_duration_seconds": null, "explanation": "V prvej hre bol Mario tesár, ktorý zachraňuje dievča pred gorilou na stavenisku. Inštalatérom sa stal až o dva roky neskôr v hre Mario Bros., kde behá po kanáloch.", "embedding_model": "text-embedding-3-small", "embedding_dim": 1536, "subtopic": null, "answer_key": null, "embedding_qa_model": "text-embedding-3-small", "expires_at": null, "freshness_tag": null, "boost_until": null}, {"id": "394ab4d9-6f84-45e0-908c-f4015fe0b13a", "question": "Filmová séria Piráti z Karibiku s Johnnym Deppom nevznikla podľa knihy ani komiksu. Jej predlohou bola atrakcia, na ktorej sa návštevníci vozia na loďkách pomedzi bábkových pirátov. Kde túto atrakciu otvorili?", "type": "text", "possible_answers": null, "correct_answer": "V Disneylande", "alternative_answers": ["Disneyland", "v Disneyho zábavnom parku", "v zábavnom parku Disney"], "headline_answer": null, "topic": "Hollywoodske filmy", "category": "entertainment", "difficulty": "medium", "tags": [], "language_dependent": false, "age_appropriate": "all", "language": "sk", "pack_id": null, "prompt_seed": "e143544a32a2cef5", "created_at": "2026-10-14T13:18:56.660875", "created_by": null, "source": "generated", "source_url": "https://en.wikipedia.org/wiki/Pirates_of_the_Caribbean_(attraction)", "source_excerpt": "The original version of the ride opened at the Disneyland in Anaheim, California.", "usage_count": 0, "user_ratings": {}, "review_status": "approved", "reviewed_by": "machine:gates-v1", "reviewed_at": "2026-10-14T11:19:28.866246Z", "review_notes": null, "quality_ratings": null, "generation_metadata": {"model": "claude-opus-5-5", "provider": "anthropic", "prompt_version": "direct_v1", "pipeline": null, "generation_flow": "fun-redesign-72", "generation_temperature": null, "critique_model": null, "critique_score": null, "reasoning_pattern": "unexpected_source", "fact_ids": [], "extra": {"stage": "initial_generation", "escape_hatch": true, "gen_craft_guards": true, "why_interesting": "Most people assume a blockbuster franchise grows out of a novel or a comic. This one was adapted from an amusement-park boat ride, and the Disney connection lets a player reason their way there.", "topicality": {"tier": "none", "event_date": null, "rationale": "Film and theme-park history about the origin of Pirates of the Caribbean; evergreen, not topical."}, "factcheck_tier": "web", "verified": true, "verification_score": 0.9, "verification_notes": "The original Pirates of the Caribbean ride opened at Disneyland in Anaheim in 1967, and the films were based on it (https://en.wikipedia.org/wiki/Pirates_of_the_Caribbean_(attraction))."}, "created_at": null}, "cost_cents": null, "media_url": null, "image_subtype": null, "media_duration_seconds": null, "explanation": "Atrakcia Pirates of the Caribbean sa otvorila v kalifornskom Disneylande v roku 1967, takmer štyridsať rokov pred prvým filmom. Ako jednu z posledných na nej ešte pracoval sám Walt Disney.", "embedding_model": "text-embedding-3-small", "embedding_dim": 1536, "subtopic": null, "answer_key": null, "embedding_qa_model": "text-embedding-3-small", "expires_at": null, "freshness_tag": null, "boost_until": null}]}, "cs": {"status": "done", "reason": null, "seeds": 20, "seed_candidates": 36, "seed_digest_lines": 45, "seed_harvested": 48, "seed_dropped": {"low_credibility": 1, "page_mismatch": 5, "same_subject": 1, "low_fame": 9}, "page_check": {"page_ok": 29, "page_mismatch": 5, "page_unchecked": 1}, "domestic_share": 1.0, "fame_checked": true, "cost": {"seeds_usd": 0.33, "seed_gather_usd": 0.0969, "seed_pick_usd": 0.233, "total_usd": 0.33, "model_usd": 0.0, "factcheck_search_usd": 0.0}, "unpriced_models": ["session:opus", "session:sonnet"], "generated": 15, "approved": 15, "pending": 0, "inserted": 15, "dropped": {}, "pending_reasons": {}, "questions": [{"id": "12548c53-ea95-4b0b-9fcc-9f9138342931", "question": "V září 2026 zemřel Richard Tesařík, spoluzakladatel skupiny Yo Yo Band. Její nejslavnější hit Rybitví má hodně neobvyklý text. Z čeho je vlastně celý poskládaný?", "type": "text", "possible_answers": null, "correct_answer": "Z názvů českých měst a obcí", "alternative_answers": ["Z názvů obcí", "Z názvů měst", "Z názvů vesnic", "Z českých místních jmen", "Ze jmen českých obcí a měst", "Je to seznam českých míst"], "headline_answer": "