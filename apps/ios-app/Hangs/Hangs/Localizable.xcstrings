    "Apple echo cancellation, noise suppression and gain control on the microphone, while sound plays from the iPhone or in Call Mode" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potlačení ozvěny, šumu a vyrovnání hlasitosti mikrofonu od Apple, když zvuk hraje z iPhonu nebo v režimu hovoru"
