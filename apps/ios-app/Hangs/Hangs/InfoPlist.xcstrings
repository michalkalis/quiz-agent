{
  "sourceLanguage" : "en",
  "strings" : {
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trubbo používá mikrofon k poslouchání tvých hlasových odpovědí v kvízu a hlasových příkazů."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trubbo uses the microphone to hear your spoken quiz answers and voice commands."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trubbo používa mikrofón na počúvanie tvojich hlasových odpovedí v kvíze a hlasových príkazov."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trubbo використовує мікрофон, щоб чути твої голосові відповіді у вікторині та голосові команди."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovládáš kvíz hlasovými příkazy, třeba „dál“. Řeč se rozpoznává jen ve tvém zařízení."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets you control the quiz with voice commands like “next”. Recognition stays on your device."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovládaš kvíz hlasovými príkazmi, napríklad „ďalej“. Reč sa rozpoznáva len v tvojom zariadení."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Керуй вікториною голосовими командами, наприклад «далі». Мовлення розпізнається лише на твоєму пристрої."
          }
        }
      }
    }
  },
  "version" : "1.1"
}
