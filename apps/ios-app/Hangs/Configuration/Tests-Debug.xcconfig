//
// Tests-Debug.xcconfig
// Base config for the test targets (HangsTests / HangsUITests), Debug builds.
// Shared carries Swift 6 + deployment target (single source of truth);
// Debug carries build-mode settings (ENABLE_TESTABILITY, -Onone).
//

#include "Shared.xcconfig"
#include "Debug.xcconfig"

// #97 — CarPlay support: the host app compiles its CarPlay code in Local builds
// only (Local.xcconfig), so the CarPlay tests compile only against that host.
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug-Local] = CARPLAY $(inherited)
